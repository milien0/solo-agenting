# Local ChatGPT subscription mode uses Codex-owned login; no credentials copied.
# For cloud deployment use MODEL_PROVIDER=gateway and AI_GATEWAY_API_KEY.
MODEL_PROVIDER=chatgpt
EVE_MODEL=gpt-6.1-sol
# AI_GATEWAY_API_KEY=
HOST=127.0.0.1
PORT=4310
EVE_PORT=2000
MAX_WORKERS=3
TICK_SECONDS=900
TASK_TIMEOUT_SECONDS=900
MAX_SESSION_COST_USD=1
MAX_TOTAL_MODEL_COST_USD=20
INITIAL_CAPITAL_USD=200
TARGET_REVENUE_USD=1000
CHALLENGE_DAYS=30
AUTO_START_EVE=true

# Only enable actions for accounts you have delegated to this agent.
ENABLE_PUBLIC_ACTIONS=false
ENABLE_FINANCIAL_ACTIONS=false
STRIPE_CATALOG_WRITE_ENABLED=false
GMAIL_DRAFT_ENABLED=false
GMAIL_SEND_ENABLED=false
X_POST_ENABLED=false

# Optional integrations. Never commit actual values.
# GITHUB_TOKEN=
# GITHUB_AUTH_FROM_GH=true
# BRAVE_SEARCH_API_KEY=
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_WALLET_ADDRESS=
# SOLO_VAULT_DIR=/private/owner/directory/solo-agentic-vault
# STRIPE_SECRET_KEY=
# GMAIL_ACCESS_TOKEN=
# X_BEARER_TOKEN=
# X_USER_ACCESS_TOKEN=
# VERCEL_TOKEN=
# RENDER_API_KEY=
# MCP_SERVER_URL=
# MCP_ALLOWED_TOOLS=
# MCP_ACCESS_TOKEN=
# Set a long random SOLO_API_TOKEN for authenticated cloud/private hosting.
# SOLO_API_TOKEN=
