    "background:stop": "node scripts/background.mjs stop"
  },
  "dependencies": {
    "ai": "^7.0.137",
    "eve": "^0.76.0",
    "just-bash": "^3.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
