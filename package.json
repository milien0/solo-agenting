{
  "name": "solo-agentic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "agent": "eve dev",
    "build": "eve build",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "tools": "tsx scripts/list-tools.ts",
    "doctor": "tsx scripts/doctor.ts",
