{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "lib": ["ES2023", "DOM"], "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "agent/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
